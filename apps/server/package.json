{
  "name": "@hono-elplus-admin/server",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --import tsx src/bootstrap.ts",
    "build": "tsc",
    "start": "node dist/bootstrap.js",
    "test": "node --experimental-strip-types --test",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:introspect": "drizzle-kit introspect --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-openapi": "^0.19.0",
    "@scalar/hono-api-reference": "^0.5.0",
    "better-auth": "1.6.23",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "mysql2": "^3.9.0",
    "redis": "^6.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.41",
    "drizzle-kit": "^0.31.10",
    "rimraf": "^6.1.3",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3"
  }
}
